{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/data-science",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/data-science/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/data-science/:path*",
      "destination": "/index.html"
    }
  ]
}