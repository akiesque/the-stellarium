{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/data-science",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/data-science/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/data-science/((?!.*\\.).*)",
      "destination": "/index.html"
    },
    {
      "source": "/data-science",
      "destination": "/index.html"
    }
  ]
}